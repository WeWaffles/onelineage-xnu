+/*
+ * m485: one monotonic sequence across the wait/wake/return triple.
+ *
+ * hw/m484 showed wait4 sleeping and the exiting child waking the same address,
+ * yet no return, so the next question is order of events rather than identity
+ * of the object.  Each record carries the sequence number it was stamped with,
+ * the values that identify the event, and its magic written last:
+ *
+ *   0x9660  wait goes to sleep:  seq, waiter pid, sleep address, "SLEP"
+ *   0x9680  child wakes parent:  seq, exiting pid, parent proc, "WAUW"
+ *   0x96a0  wait4 returns:       seq, caller pid, reaped rval, "RET"
+ */
+unsigned int sweet_trace_seq;
+
+void
+sweet_trace_record(uint64_t base, uint64_t a, uint64_t b, uint64_t magic)
+{
+	extern void sweet_early_write64(uint64_t, uint64_t);
+	unsigned int s = ++sweet_trace_seq;
+
+	sweet_early_write64(base, (uint64_t)s);
+	sweet_early_write64(base + 8, a);
+	sweet_early_write64(base + 0x10, b);
+	sweet_early_write64(base + 0x18, magic);
+}
