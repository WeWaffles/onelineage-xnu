+/*
+ * The EL0 fault record: four fixed slots at +0x1400, outside the log's path.
+ *
+ * hw/m490 and hw/m491 both die with the child in EL0, and both preserved rings
+ * end in 0xc4/0xf3/0xfe snapshots: the 0xc1 record sleh.c writes for a user
+ * fault is real, but it lives in the rotating 16-entry ring at +0x2000, which
+ * the kernel's own later traffic overwrites before the capture.  Fault evidence
+ * therefore gets fixed slots that only a later fault can replace.
+ *
+ * +0x1400..+0x1500 is the measured gap between the end of the proof ring
+ * (0x600 + 14 * 0x100) and the ring at 0x1500 that every capture preserves; it
+ * reads as zero in hw/m492, hw/m495 and hw/m496.  The previous page at +0x1b00
+ * was *below* nothing: the early console's cursor had already reached it, and
+ * m496 shows log text inside the slots and a record head overwritten.  Slots
+ * here cannot be reached by text the console writes upward from its cursor.
+ *
+ *   0x00 magic, 0x08 seq, 0x10 pid, 0x18 esr, 0x20 far, 0x28 pc,
+ *   0x30 exception class, 0x38 cpsr
+ */
+#define SWEET_FAULT_BASE   0x1400ULL
+#define SWEET_FAULT_SLOTS  4U
+#define SWEET_FAULT_STRIDE 0x40ULL
+#define SWEET_FAULT_MAGIC  0x313046554e584c4fULL /* "OLXNUF01" */
+
+static uint64_t sweet_fault_seq;
+
+void
+sweet_early_user_fault(uint64_t pid, uint64_t esr, uint64_t far, uint64_t pc,
+    uint64_t exception_class, uint64_t cpsr)
+{
+	uint64_t seq = ++sweet_fault_seq;
+	/*
+	 * Slots are indexed by process, not by arrival.  hw/m492 and hw/m495 both
+	 * lost the child's fault because the harness's EL0 SVCs had filled all
+	 * eight records before it: the recorder was a first-come ring shared by
+	 * every process.  Indexing by pid means one process's traffic can never
+	 * consume another's slot; within a pid the newest fault replaces the
+	 * oldest, and the global sequence number keeps the ordering readable.
+	 */
+	uint64_t off = SWEET_FAULT_BASE +
+	    (pid % SWEET_FAULT_SLOTS) * SWEET_FAULT_STRIDE;
+
+	sweet_early_write64(off + 0x00, SWEET_FAULT_MAGIC);
+	sweet_early_write64(off + 0x08, seq);
+	sweet_early_write64(off + 0x10, pid);
+	sweet_early_write64(off + 0x18, esr);
+	sweet_early_write64(off + 0x20, far);
+	sweet_early_write64(off + 0x28, pc);
+	sweet_early_write64(off + 0x30, exception_class);
+	sweet_early_write64(off + 0x38, cpsr);
 }
 
