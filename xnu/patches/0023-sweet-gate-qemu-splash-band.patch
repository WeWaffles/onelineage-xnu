diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 9d12ce8..4d62060 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -488,8 +488,16 @@ LEXT(start_first_cpu)
 	mov		x20, x0
 	mov		x21, #0
 
-#if defined(SWEET)
-	/* Stage 0: white 64x32 band, no stack or page tables needed. */
+/*
+ * Stage 0: white 64x32 band, no stack or page tables needed.
+ *
+ * This is a QEMU-only debug visual: it hardcodes the virt board's framebuffer
+ * at 0x9c000000 and runs BEFORE the exception vectors are installed.  On real
+ * hardware that physical range is not non-secure writable memory, so the store
+ * takes an external abort, the core vectors through the still-zero VBAR and the
+ * boot dies silently with no output anywhere.  Enabled only for QEMU builds.
+ */
+#if defined(SWEET) && defined(SWEET_EARLY_SPLASH)
 	MOV64	x0, (0x9c000000 + 2368 * 4320)
 	mov		w1, #-1
 	mov		x2, #32
