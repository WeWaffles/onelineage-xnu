+
+/*
+ * m477: the counters that hw/m476 could not explain.
+ *
+ * hw/m474-m476 all read writes_seen=11 with a last write of pid=2 fd=0 len=0
+ * result=2, although this payload issues two writes; and execs_entered=3
+ * against execs_loaded=2.  Both words sat at once-written offsets, so residue
+ * from an earlier boot could not be ruled out.  These counters are emitted by
+ * sweet_exec_refresh() instead, i.e. rewritten at exception rate, so their
+ * values are fresh by construction.  They split by pid and count zero-length
+ * writes, which is what the anonymous fd=0 len=0 record looks like.
+ */
+unsigned int sweet_exec_enters_total, sweet_exec_enters_pid1;
+unsigned int sweet_exec_enters_pid2, sweet_exec_enters_other;
+unsigned int sweet_exec_loads_total;
+unsigned int sweet_writes_total, sweet_writes_pid1, sweet_writes_pid2;
+unsigned int sweet_writes_other, sweet_writes_zero;
+
+void
+sweet_count_write(uint32_t pid, uint32_t fd, uint32_t len)
+{
+	(void)fd;
+	sweet_writes_total++;
+	if (pid == 1) {
+		sweet_writes_pid1++;
+	} else if (pid == 2) {
+		sweet_writes_pid2++;
+	} else {
+		sweet_writes_other++;
+	}
+	if (len == 0) {
+		sweet_writes_zero++;
+	}
+}
 
