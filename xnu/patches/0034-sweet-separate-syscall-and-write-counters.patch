 unsigned int sweet_writes_total, sweet_writes_pid1, sweet_writes_pid2;
 unsigned int sweet_writes_other, sweet_writes_zero;
+
+/*
+ * m478: syscalls and writes are different things and must not share a name.
+ *
+ * hw/m477 proved the 0x8700 block sits after the "if (code == SYS_write)"
+ * guard closes, so it runs on every BSD syscall: its 11 was the syscall
+ * count and its "fd=0 len=0 result=2" was getpid returning pid 2.  A
+ * write-only counter placed there silently counted syscalls.  The families
+ * are split by what increments them and 0x8730 records the code.
+ */
+void
+sweet_count_syscall(uint32_t pid, uint32_t code)
+{
+	sweet_syscalls_total++;
+	sweet_syscalls_last_code = code;
+	if (pid == 1) {
+		sweet_syscalls_pid1++;
+	} else if (pid == 2) {
+		sweet_syscalls_pid2++;
+	} else {
+		sweet_syscalls_other++;
+	}
+}
 
