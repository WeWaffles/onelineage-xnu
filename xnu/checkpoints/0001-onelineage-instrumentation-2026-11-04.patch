+}
+
+/*
+ * Redundant evidence snapshot.
+ *
+ * The log region is shared with Linux's own log buffer, and last_kmsg is read
+ * after that log has been written again, so individual slots at fixed offsets
+ * are not trustworthy: hw/m166 showed a magic written at +0x1a30 come back
+ * missing while its two neighbours survived, and an earlier run read the ring
+ * tag "XNUKRN1\n" out of a slot that should have held CNTPCT_EL0.  Guessing a
+ * base then produced plausible-but-wrong numbers, which is worse than no data.
+ *
+ * This publishes the same 64-byte record at 16 places, 256 bytes apart, so the
+ * survivor set identifies the channel regardless of where the buffer wrapped,
+ * and a sequence number says which snapshot is the newest.  Every copy carries
+ * its own index, so a single intact copy is enough to read the state.
+ */
+#define SWEET_EVIDENCE_MAGIC 0x313053534e4e584c4fULL /* "OLXNNSS01" */
+/*
+ * 1.5 MB into the 2 MB store, not 8 KB into it.
+ *
+ * At +0x2000 the answer to "did this run produce evidence" depended on luck:
+ * hw/m260 and hw/m261 each yielded exactly one surviving slot (the newest
+ * group's), because the *next* boot's own log is written from the start of the
+ * same store and wipes everything near it.  The entry stub already puts its
+ * marker 1 MB in for exactly this reason.  The ring is 64 slots x 256 bytes, so
+ * +0x180000..+0x184000 stays inside the block that arm_vm_init maps for it
+ * (SWEET_LOG_BASE is 0x10000 into a 2 MB block) and out of the region the next
+ * boot fills first.
+ */
+/*
+ * Kept at +0x2000: moving it to +0x180000 was tried and measured worse.
+ *
+ * hw/m315 ran a kernel built with SWEET_EVIDENCE_BASE 0x180000 and came back
+ * with zero records, while the same dump's channel header decoded normally
+ * (+0x1780 = 0xAA13, label PE_lockdown_ioki, hook _pgz_init), i.e. the kernel
+ * ran and wrote the low slots.  The store's printable coverage in that dump is
+ *
+ *   text 0x000000..0x142000   bin 0x142000..0x143000   mixed 0x143000..0x144000   text 0x144000..
+ *
+ * so the part of the store that survives the next boot is a small island at the
+ * channel base, not a distant offset: 1.5 MB in is inside the log and is gone.
+ * The same island shape appears in the two runs that did keep their records
+ * (m310 island 0x13c000..0x142000, m312 0x0bc000..0x0c2000), which is why the
+ * ring stays at +0x2000 and why the four proof records also get a second,
+ * smaller ring inside the island's first 8 KB (see SWEET_PROOF_BASE).
+ */
+#define SWEET_EVIDENCE_BASE  0x2000ULL
+#define SWEET_EVIDENCE_STRIDE 0x100ULL
+/*
+ * 16 groups of 4 copies, spanning +0x2000..+0x6000.  The ring is the only
+ * frontier record that survives independently of the channel base, and a
+ * boot now emits a pair of snapshots per STARTUP() entry (kern/startup.c),
+ * so it has to hold enough history to cover an entry that hangs: 4 copies per
+ * group means the last 16 snapshots — eight startup entries' worth — are kept
+ * while still holding two copies of each, which is what the reader requires
+ * before it believes a number.
+ *
+ * Nothing else writes above the identity record at +0x1a30, and the log alias
+ * is one 2MB L2 block, so +0x6000 is safely inside it.
+ */
+#define SWEET_PROOF_BASE      0x600ULL /* first free window below the hooks slot */
+#define SWEET_PROOF_RECORDS   6U /* 0xd6, 0xd7, 0xec, 0xe2 + 0xad heartbeats */
+#define SWEET_PROOF_COPIES    2U
+#define SWEET_PROOF_SLOTS     (SWEET_PROOF_RECORDS * SWEET_PROOF_COPIES)
+/*
+ * Two more slots, outside the rotation, for the watchdog probe.
+ *
+ * The pet writes 1 to APSS_WDT_RST and nothing has ever read the register back,
+ * so "the watchdog was petted" was an assumption.  Slots 12 and 13 hold the
+ * value read back immediately after the write, twice, so the reader can tell a
+ * pet that stuck from one that landed in a register that is not what the
+ * bootloader armed.
+ */
+#define SWEET_PROOF_PET_SLOTS 12U
+#define SWEET_PROOF_ALL_SLOTS (SWEET_PROOF_SLOTS + 2U)
+#define SWEET_EVIDENCE_COPIES 64U
+#define SWEET_EVIDENCE_GROUPS 16U
+#define SWEET_EVIDENCE_PER_GROUP (SWEET_EVIDENCE_COPIES / SWEET_EVIDENCE_GROUPS)
+
+static uint64_t sweet_evidence_seq;
+
+/*
+ * Watchdog heartbeat.
+ *
+ * The board's APSS watchdog is armed by the bootloader, and the jump module
+ * pets it exactly once before handing the core over — which buys one bark
+ * period and nothing more.  Measured at hw/m179: a jump at 03:54:45, and the
+ * fresh boot's own uptime put the reset at 03:55:03.  Eighteen seconds was the
+ * entire budget for the boot, so the frontier this port kept chasing was often
+ * just the clock running out wherever the kernel happened to be.
+ *
+ * Pushing a snapshot into the channel is the one thing the boot does only when
+ * it is making progress, so pet the watchdog there.  A boot that keeps moving
+ * keeps its CPU; a boot that stops is reset by the hardware as intended, and
+ * its last snapshot — the frontier — is still in the log for the next boot.
+ *
+ * Deriving the budget from the boot's own progress is what makes this useful:
+ * no fixed timeout has to be guessed, and a slow stage is not mistaken for a
+ * hang.
+ */
+#define SWEET_WDT_RST_PA 0x17600004ULL  /* Installed qcom_soc_wdt: reset=+4, status=+0xc. */
+
+/*
+ * ...but not without limit.
+ *
+ * The log only exists because the hardware resets the board: every snapshot
+ * this port has ever read came out of the *next* boot's last_kmsg.  A boot that
+ * keeps petting forever is a boot nobody can see, so the heartbeat gets a
+ * fixed allowance and then stops, and the hardware ends the run as it always
+ * did.  150 s is many times the longest stage seen so far (the whole boot up to
+ * the BSD root wait is under 5 s of kernel time), so a real stop is still
+ * identified by where the snapshots end, not by the clock.
+ *
+ * CNTPCT runs at the SoC's timebase, which mk_sm8850_adt.py publishes as
+ * 19.2 MHz; the budget is a safety valve, so a wrong timebase would only make
+ * it longer or shorter, never wrong in kind.
+ */
+/*
+ * 150 s kept the boot alive but cost the evidence: hw/m252..m259 pull dumps
+ * that contain no channel at all (not even the stub's own XNUKRN1 tag), while
+ * every run that ended around 25 s - m240..m251 - decodes.  A run nobody can
+ * read is worth less than a shorter one that reports where it got to, so the
+ * budget is back near the window those runs had.
+ */
+/*
+ * 60 s, not 30: the E3 rung is "the board survives >= 30 s past the first EL0
+ * syscall", and the budget boundary is what now ends a healthy run, so the
+ * surviving heartbeat has to read clearly past the bar rather than a hair
+ * under it.  When the budget runs out the pet stops and the bark that follows
+ * (~18 s) is what resets the board and preserves the dump.
+ */
+#define SWEET_WDT_BUDGET_TICKS (60ULL * 19200000ULL)
+/* Pet at most once a second: the watchdog timeout is tens of seconds, and a pet on
+ * every evidence call is ~3500 uncached MMIO writes plus dsb, which measurably eats
+ * the boot (hw/m331 vs hw/m330). */
+#define SWEET_WDT_PET_INTERVAL (19200000ULL)
+/*
+ * Off for the m331 test.
+ *
+ * Depth fell from 44221-47676 (m308-m312, m316, which reached userspace) to the
+ * 1756 early-boot band from m322 on.  Uptime does not separate those runs --
+ * 22-28 s deep against 11-30 s shallow -- so the shallow ones are not simply
+ * shorter; they never reach the syscall path that emits most records.  The
+ * canary was ruled out (hw/m330).  The other change of that pass was the kernel
+ * petting 0x17600004, the reset register of the installed qcom_soc_wdt: a write
+ * of 1 to a write-1-to-reset register is not a safe thing to do and has never
+ * been tested on its own.  With this at 0 the kernel never touches it.
+ */
+#define SWEET_WDT_PET_ENABLED 0
+/*
+ * Off again after hw/m332.
+ *
+ * The 1 Hz rate limit did not preserve depth: m332 came back at stage 4 with no
+ * ring, the same as m330 which petted on every call, against m331 (no pet at
+ * all) at stage 20 and sequence 14921.  So the cost of the writes is not the
+ * whole story -- every configuration that writes 0x17600004 lands in the shallow
+ * band while the one that never writes it does not.  Until the register's
+ * semantics are established, the kernel does not touch it.
+ */
+
+static uint64_t sweet_wdt_t0;
+static uint64_t sweet_wdt_last;
+
+/*
+ * The WDT is a device register, not RAM.
+ *
+ * Petting it through the physical-address helpers was fatal: the bootstrap
+ * table only maps RAM V=P, so the store took a *translation fault* and the
+ * kernel's own fault vector (start.s: Lsweet_vec_sync) disabled the MMU and
+ * halted the core.  hw/m186_a1 recorded exactly that:
+ *
+ *   XNFAULT  ESR 0000000096000045   (EC 0x25, DFSC 0x05: translation, level 1)
+ *            FAR 000000001760000c   (the WDT RST register itself)
+ *            ELR fffffff00744f134   (inside sweet_early_evidence)
+ *
+ * That is why every run after the heartbeat was added reported "no markers":
+ * the kernel died in its first snapshot, before any stage could be written.
+ *
+ * So the page is mapped properly, once, the same way pe_fiq.c maps the GIC,
+ * and only after the pmap has an I/O mapping path at all (bsd_init).  Early
+ * boot is not petted because it does not need it: it takes well under a second
+ * up to the BSD root wait, which is the first place the hardware watchdog was
+ * actually cutting a run short.
+ */
+extern uintptr_t ml_io_map(uintptr_t phys_addr, size_t size);
+
+/*
+ * ...and the framebuffer console needs it from the start.
+ *
+ * This used to be 0x9c (bsd_init and later) on the theory that early boot is
+ * fast enough not to need a pet.  It is not, once there is a panel to draw on:
+ * hw/m246..m250 show the boot reaching machine_startup with 28 characters
+ * printed, and hw/m241..m251 are all cut off ~24 s after the jump because
+ * nothing between 0x90 and 0x9c ever pets.  The console work is what fills that
+ * window, and it is progress, which is exactly what the pet is for.
+ *
+ * ml_io_map() is safe here: it is the identity store that faulted in hw/m186,
+ * and io_map() has a pre-KMEM path that pmap_map_bd()s a single page.
+ */
+/*
+ * ...but not from the console's stages, which is the opposite of what the note
+ * above says, and the reason is a panic rather than a preference.
+ *
+ * ml_io_map() before STARTUP_SUB_KMEM takes its boot pool by bumping
+ * virtual_space_start, and pmap_map_bd() *panics* when the next page has no PTE
+ * (osfmk/arm/pmap/pmap.c:1940, "pmap_map_bd").  With the threshold at 0x90 the
+ * first pet fired inside the SMMU survey, at 0xb6 — before fbcon_probe() had
+ * registered anything — and the pool gave out at virt 0x1eb000.  hw/m260..m264
+ * each decode exactly that record (0xc0) and nothing after it, and the white
+ * flash on the panel is that panic, not a watchdog reset.  Every console run
+ * since the threshold was lowered therefore died before printing a character.
+ *
+ * 0x9c is bsd_init and later, where io_map() has switched to kernel_map and a
+ * mapping cannot exhaust the boot pool.
+ */
+#define SWEET_WDT_MIN_STAGE 0x9c        /* bsd_init and later */
+
+static uintptr_t sweet_wdt_kva;
+static int sweet_wdt_dead;
+static uint64_t sweet_wdt_pets;
+
+static void sweet_proof_write_slot(uint64_t slot, uint64_t stage, uint64_t a,
+    uint64_t b, uint64_t c, uint64_t d);
+
+static inline uint64_t
+sweet_wdt_now(void)
+{
+	uint64_t v;
+	__asm__ volatile("mrs %0, CNTPCT_EL0" : "=r"(v));
+	return v;
+}
+
+static inline void
+sweet_wdt_pet(uint64_t stage)
+{
+	uint64_t now;
+
+	if (!SWEET_WDT_PET_ENABLED || stage < SWEET_WDT_MIN_STAGE || sweet_wdt_dead) {
+		return;
+	}
+
+	if (sweet_wdt_kva == 0) {
+		sweet_wdt_kva = ml_io_map(SWEET_WDT_RST_PA & ~0xFFFULL, 0x1000);
+		if (sweet_wdt_kva == 0) {
+			sweet_wdt_dead = 1;
+			return;
+		}
+	}
+
+	now = sweet_wdt_now();
+	if (sweet_wdt_t0 == 0) {
+		sweet_wdt_t0 = now;
+	}
+	if (now - sweet_wdt_t0 > SWEET_WDT_BUDGET_TICKS) {
+		return;
+	}
+	if (sweet_wdt_last != 0 &&
+	    now - sweet_wdt_last < SWEET_WDT_PET_INTERVAL) {
+		return;
+	}
+	sweet_wdt_last = now;
+
+	*(volatile uint32_t *)(sweet_wdt_kva + (SWEET_WDT_RST_PA & 0xFFF)) = 1;
+	sweet_wdt_pets++;
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	/* Keep the pet write-only: the reset register read semantics are unverified. */
+}
+
+void
+
+sweet_early_evidence(uint64_t stage, uint64_t a, uint64_t b, uint64_t c,
+    uint64_t d)
+{
+	/*
+	 * hw/m379: the ring holds 16 records and the console emits 0xc6 for its
+	 * own traffic at character rate, so a run that prints anything erases the
+	 * events it is trying to observe.  bsd/dev/arm/systemcalls.c:446 already
+	 * notes this ("rotated out of the 16-record ring - by the console's
+	 * thousands of 0xc6").  Keep a few of the noisy tags, let the rest through.
+	 */
+	if (stage == 0xc6) {
+		static int sweet_c6;
+		if (sweet_c6 >= 2) {
+			return;
+		}
+		sweet_c6++;
+	}
+
+	if (stage == 0xb6) {
+		static int sweet_b6;
+
+		/* Before the fork, trap records are boot noise; after it they are the
+		 * only evidence that the parent is running again (see hw/m382). */
+		if (!sweet_fork_seen || sweet_b6 >= 10) {
+			return;
+		}
+		sweet_b6++;
+	}
+
+	const uint64_t magic = 0x313053534e584c4fULL; /* "OLXNS01" */
+	uint64_t seq = ++sweet_evidence_seq;
+
+	sweet_wdt_pet(stage);
+
+	/*
+	 * Rotate through SWEET_EVIDENCE_GROUPS groups of SWEET_EVIDENCE_PER_GROUP
+	 * copies.  Writing every snapshot to all of them keeps only the newest,
+	 * and the boot needs a *history*: which stage it reached, and the numbers
+	 * that stage was working on, are two consecutive snapshots.  The group
+	 * count is the history depth, and two copies per stage is already one more
+	 * than the reader needs to believe a snapshot.
+	 */
+	uint64_t group = seq % SWEET_EVIDENCE_GROUPS;
+
+	for (unsigned int j = 0; j < SWEET_EVIDENCE_PER_GROUP; j++) {
+		unsigned int i = (unsigned int)(group * SWEET_EVIDENCE_PER_GROUP) + j;
+		uint64_t off = SWEET_EVIDENCE_BASE + i * SWEET_EVIDENCE_STRIDE;
+
+		sweet_early_write64(off + 0x00, magic);
+		sweet_early_write64(off + 0x08, (uint64_t)i);
+		sweet_early_write64(off + 0x10, seq);
+		sweet_early_write64(off + 0x18, stage);
+		sweet_early_write64(off + 0x20, a);
+		sweet_early_write64(off + 0x28, b);
+		sweet_early_write64(off + 0x30, c);
+		sweet_early_write64(off + 0x38, d);
+	}
+}
+
+/*
+ * The proof ring: four records, two copies each, at the base of the store.
+ *
+ * The 64-slot history ring at +0x2000 competes with every other snapshot for
+ * space and, in about a third of the dumps on disk, the whole window is gone.
+ * The four records that answer "is the scanout path programmed as claimed" -
+ * 0xd6/0xd7 format and stride, 0xec the address pair, 0xe2 the unpack group -
+ * do not need history: only the newest set matters.  So they get their own
+ * small ring, and it sits in the first 8 KB of the store, which is the part the
+ * measurements above show surviving the next boot.
+ *
+ * Two copies per record because read_channel.py refuses to believe a value it
+ * has only seen once.  Four records x 2 copies = 8 slots of 256 bytes = 2 KB.
+ *
+ * A boot that dies before the first proof record does not leave the previous
+ * boot's values behind looking fresh: seq 1 zeroes all eight slots first.
+ */
+static uint64_t sweet_proof_seq;
+
+void
+sweet_early_proof(uint64_t stage, uint64_t a, uint64_t b, uint64_t c,
+    uint64_t d)
+{
+	const uint64_t magic = 0x313053534e584c4fULL; /* "OLXNS01" */
+	uint64_t seq = ++sweet_proof_seq;
+
+	sweet_wdt_pet(stage);
+
+	if (seq == 1) {
+		for (unsigned int i = 0; i < SWEET_PROOF_ALL_SLOTS; i++) {
+			sweet_early_write64(SWEET_PROOF_BASE + i * SWEET_EVIDENCE_STRIDE, 0);
+		}
+	}
+
+	uint64_t first = (seq % SWEET_PROOF_RECORDS) * SWEET_PROOF_COPIES;
+
+	for (unsigned int j = 0; j < SWEET_PROOF_COPIES; j++) {
+		uint64_t i = first + j;
+		uint64_t off = SWEET_PROOF_BASE + i * SWEET_EVIDENCE_STRIDE;
+
+		sweet_early_write64(off + 0x00, magic);
+		sweet_early_write64(off + 0x08, i);
+		sweet_early_write64(off + 0x10, seq);
+		sweet_early_write64(off + 0x18, stage);
+		sweet_early_write64(off + 0x20, a);
+		sweet_early_write64(off + 0x28, b);
+		sweet_early_write64(off + 0x30, c);
+		sweet_early_write64(off + 0x38, d);
+	}
+}
+
+/*
+ * Boot progress: how long, and how far, the boot ran after EL0.
+ *
+ * The only barrier left after bsd_init was the watchdog.  Nothing pets it once
+ * PID 1 stops calling into the kernel, so those runs died about 18 s after the
+ * last syscall and left no record of when.  This record is emitted from the
+ * syscall path and carries its own clock, so the time needs no external
+ * constant:  milliseconds = b * 1000 / c.
+ *
+ *   a = syscalls served since boot   b = ticks since the first watchdog pet
+ *   c = CNTFRQ_EL0 in Hz             d = watchdog pets issued
+ *
+ * It goes to the two-copy ring at SWEET_PROOF_BASE, so it survives the next
+ * boot even when the 64-slot history ring does not.
+ */
+/*
+ * One proof slot, written raw: no pet, no rotation.  Used by the watchdog probe,
+ * which runs *inside* the pet and so must not recurse into it.
+ */
+static void
+sweet_proof_write_slot(uint64_t slot, uint64_t stage, uint64_t a, uint64_t b,
+    uint64_t c, uint64_t d)
+{
+	const uint64_t magic = 0x313053534e584c4fULL; /* "OLXNS01" */
+	uint64_t off = SWEET_PROOF_BASE + slot * SWEET_EVIDENCE_STRIDE;
+
+	sweet_early_write64(off + 0x00, magic);
+	sweet_early_write64(off + 0x08, slot);
+	sweet_early_write64(off + 0x10, 0);
+	sweet_early_write64(off + 0x18, stage);
+	sweet_early_write64(off + 0x20, a);
+	sweet_early_write64(off + 0x28, b);
+	sweet_early_write64(off + 0x30, c);
+	sweet_early_write64(off + 0x38, d);
+}
+
+void
+sweet_boot_progress(uint64_t syscalls)
+{
+	uint64_t frq;
+
+	__asm__ volatile("mrs %0, CNTFRQ_EL0" : "=r"(frq));
+	if (frq == 0) {
+		frq = 19200000ULL;
+	}
+	/* Display reports churn the rotating ring; keep the heartbeat separately. */
+	sweet_wdt_pet(0xad);
+	uint64_t ticks = sweet_wdt_now() - sweet_wdt_t0;
+	sweet_proof_write_slot(SWEET_PROOF_PET_SLOTS, 0xad, syscalls, ticks, frq,
+	    sweet_wdt_pets);
+	sweet_proof_write_slot(SWEET_PROOF_PET_SLOTS + 1, 0xad, syscalls, ticks, frq,
+	    sweet_wdt_pets);
+	sweet_channel_canary(0xad);
 }
 
