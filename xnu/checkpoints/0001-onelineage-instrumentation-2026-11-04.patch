diff -ruN a/bsd/kern/sys_generic.c build/xnu-src/source/bsd/kern/sys_generic.c
--- a/bsd/kern/sys_generic.c	2026-11-03 17:51:44
+++ build/xnu-src/source/bsd/kern/sys_generic.c	2026-11-02 08:04:36
@@ -707,21 +707,40 @@
  * threads are excluded via the kernproc check so kernel-initiated writes do not
  * light up the marker.
  *
- * The store goes through the cacheable physmap, so the line has to be cleaned
- * explicitly: a dirty line that never gets evicted is lost when the watchdog
- * resets the board, and the marker would silently never reach DRAM.
+ * No cache maintenance: ml_phys_write_double_64() stores through the uncached
+ * copy window.  The flush_dcache64() that used to follow it resolved the
+ * channel's physical address with phystokv(), which panics for any address
+ * outside the ADT's declared DRAM window -- and SWEET_LOG_BASE (0x8883F0000)
+ * is outside the 64 MB window at 0xAE0000000.  Any userland write(2) would
+ * therefore have panicked the kernel before the marker could mean anything,
+ * which is one reason XNUEL01 was never seen on hardware.
  */
 #if defined(__arm64__)
 extern void ml_phys_write_double_64(unsigned long long paddr, unsigned long long data);
-extern void flush_dcache64(unsigned long long addr, unsigned count, int phys);
+/* Declared here, like in the other BSD files: the arm headers are not included
+ * from this translation unit. */
+extern void sweet_early_evidence(uint64_t, uint64_t, uint64_t, uint64_t,
+    uint64_t);
 
 static inline void
 onelineage_el0_marker(struct proc *p)
 {
 	if (p != kernproc) {
 		/* "XNUEL01\n" */
-		ml_phys_write_double_64(0x8883F0010ULL, 0x0a3130454c554e58ULL);
-		flush_dcache64(0x8883F0010ULL, 8, TRUE);
+		ml_phys_write_double_64(((uint64_t)(SWEET_LOG_BASE) + 0x10), 0x0a3130454c554e58ULL);
+		/*
+		 * Same fact, into the evidence ring as well.
+		 *
+		 * hw/m195 got PID 1 as far as a successful exec (entry 0x100004000,
+		 * stack 0x16fe00000) and the init's first instruction group is a
+		 * write(2), but the raw log slot above stayed empty.  The ring record
+		 * is both readable by tools/xnu/read_channel.py and pets the watchdog,
+		 * so a userland write is now visible even if the whole machine stops a
+		 * moment later.
+		 *
+		 * a = pid, b = the process's EL0 PC as it entered the kernel.
+		 */
+		sweet_early_evidence(0xa5, (uint64_t)proc_getpid(p), 1, 0, 0);
 	}
 }
 #else
