+/*
+ * sweet_smmu.c -- survey the apps SMMU and repoint the display's scanout.
+ *
+ * The phone's panel is driven by the vendor composer, so the console in our own
+ * RAM is never scanned out (XNU_PROGRESS.md, M18).  The display reads its
+ * scanout through soc:qcom,smmu_sde_unsec_cb, a context bank of the apps SMMU at
+ * 0x15000000, so the way to get our log on screen without a display driver is to
+ * rewrite the SMMU's stage-1 leaf entries for the framebuffer's IOVA run so that
+ * they point at our own buffer.  SDE, DSI and the timing engine keep running
+ * untouched, and every console write then appears on the panel.
+ *
+ * Two phases, both reported through the evidence channel because a run that gets
+ * this far still has no console of its own:
+ *
+ *   survey   read the SMMU, find the enabled context banks, walk each stage-1
+ *            table and describe its mappings (total bytes, the largest
+ *            *contiguous* IOVA run, and the first raw descriptor).  A
+ *            framebuffer is one large run, so the run is the signature that
+ *            identifies the display's context bank.
+ *
+ *   repoint  take the run that matches the ADT's `sweet-fbcon` size and rewrite
+ *            the leaf descriptors covering it to our own buffer, then invalidate
+ *            the SMMU's stage-1 TLB so the next scanout uses the new mapping.
+ *
+ * Register offsets are the ARM SMMU-500 ones from arm-smmu.h:
+ *
+ *   GR0   sCR0 0x000  sACR 0x010  ID0 0x020  ID1 0x024  ID2 0x028  ID7 0x03c
+ *   S2CR(n)   0xc00 + n*4        stream index -> context bank, type and config
+ *   GR1   CBAR(n)  n*4   CBFRSYNRA(n) 0x400+n*4   CBA2R(n) 0x800+n*4
+ *   CBn   SCTLR 0x000  TTBR0 0x020 (64-bit)  TCR 0x030 (page = 1 << pgshift)
+ *         TLBIVA 0x600  TLBIASID 0x618  TLBSYNC 0x620
+ *
+ * Only 4K and 16K granules are walked; anything else is reported as unknown
+ * rather than guessed at.
+ */
+
+/* board_config.h (through sweet_early.h) is what defines SWEET and its macros */
+#include <arm64/sweet_early.h>
+#include <vm/memory_types.h>
+#include <arm/memory_types.h>
+#include <arm/pmap/pmap.h>
+#include <kern/misc_protos.h>
+#include <machine/machine_routines.h>
+#include <mach/arm/vm_param.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/protos.h>
+#include <pexpert/device_tree.h>
+#include <stdint.h>
+
+#if defined(SWEET) && !defined(SWEET_QEMU_LOG)
+
+#define SMMU_APPS_BASE      0x15000000ULL
+/*
+ * GR0 pages (NUMPAGENDXB = 6, so 0x80000) + GR1 (0x1000 per CB register block)
+ * + eight CB pages is under 0x90000; 1 MB covers it with room to spare.
+ *
+ * This used to be 2 MB, and every page here comes from io_map()'s early pool
+ * one pmap_map_bd() at a time: hw/m260 records 0xc0 showing the watchdog page
+ * failing to map after it, which is a pool spent rather than a bad address.
+ */
+#define SMMU_MAP_SIZE       0x100000ULL
+#define SMMU_MAX_CB         64
+
+#define SMMU_GR0_SACR       0x010
+#define SMMU_GR0_ID0        0x020
+#define SMMU_GR0_ID1        0x024
+#define SMMU_GR0_ID2        0x028
+#define SMMU_GR0_ID7        0x03c
+#define SMMU_GR1_CBAR(n)    (0x000 + ((n) << 2))
+#define SMMU_GR1_CBA2R(n)   (0x800 + ((n) << 2))
+#define SMMU_S2CR(n)        (0xc00 + ((n) << 2))
+
+#define SMMU_CB_SCTLR       0x000
+#define SMMU_CB_TTBR0       0x020
+#define SMMU_CB_TCR         0x030
+#define SMMU_CB_TLBIVA      0x600
+#define SMMU_CB_TLBIASID    0x610
+#define SMMU_CB_TLBSYNC     0x7f0
+#define SMMU_CB_TLBSTATUS   0x7f4
+
+#define SCTLR_M             0x1
+
+/*
+ * Table and descriptor base addresses live in bits [47:12]; bits above are ASID
+ * or attributes.  A 36-bit mask truncates this device's DRAM (its tables sit at
+ * 0xaff25c000, above 2^36), which is what made the first walk read nothing.
+ */
+#define SMMU_ADDR_MASK      0x0000FFFFFFFFF000ULL
+#define SMMU_PA_MASK        0x0000FFFFFFFFFULL
+
+/* One table page at 4K granule, 2048 entries at 16K; depth is L1..L3. */
+#define SMMU_LEVELS         4
+#define SMMU_TABLE_MAX      2048
+#define SMMU_MAX_READS      400000ULL
+
+#define SMMU_MAX_CANDIDATES 32 /* Include all rotating full-screen buffers, not only the first four. */
+#define SMMU_CAND_MIN       0x100000ULL     /* ignore runs below 1 MB */
+
+/* Windows the framebuffer hit of the evidence ring: 16 records survive. */
+
+typedef struct {
+	uint64_t iova;
+	uint64_t pa;
+	uint64_t bytes;
+	uint64_t descs;         /* descriptors covering the run */
+} smmu_run_t;
+
+/* Stage-1 walk result for one context bank. */
+typedef struct {
+	uint64_t first_iova;
+	uint64_t total_bytes;
+	uint64_t leaves;          /* valid leaf descriptors seen */
+	uint64_t largest_bytes;   /* largest contiguous IOVA run */
+	uint64_t largest_iova;
+	uint64_t largest_pa;
+	uint64_t descriptor_probe;      /* first raw descriptor read, or 0 */
+	uint64_t reads;
+
+	uint64_t cur_iova;        /* the run being extended */
+	uint64_t cur_pa;
+	uint64_t cur_bytes;
+	uint64_t cur_descs;
+	boolean_t cur_open;
+
+	smmu_run_t cand[SMMU_MAX_CANDIDATES];
+	unsigned int ncand;
+} smmu_walk_t;
+
+typedef struct {
+	uint64_t run_iova;
+	uint64_t run_bytes;
+	uint64_t new_pa;
+	uint64_t rewritten;
+	uint64_t rewritten_bytes;
+	uint64_t skipped;
+	uint64_t first_iova;
+	uint64_t first_before;
+	uint64_t first_after;
+	uint64_t reads;
+} smmu_rewrite_t;
+
+static volatile uint32_t *
+smmu_reg(uint64_t base, uint64_t off)
+{
+	return (volatile uint32_t *)(uintptr_t)(base + off);
+}
+
+static inline uint32_t
+smmu_read32(uint64_t base, uint64_t off)
+{
+	uint32_t v = *smmu_reg(base, off);
+	__asm__ volatile("dmb sy" ::: "memory");
+	return v;
+}
+
+static inline void
+smmu_write32(uint64_t base, uint64_t off, uint32_t v)
+{
+	*smmu_reg(base, off) = v;
+	__asm__ volatile("dmb sy" ::: "memory");
+}
+
+static inline uint64_t
+smmu_read64(uint64_t base, uint64_t off)
+{
+	uint64_t lo = smmu_read32(base, off);
+	uint64_t hi = smmu_read32(base, off + 4);
+	return lo | (hi << 32);
+}
+
+/*
+ * Move data between the kernel and an arbitrary physical address.
+ *
+ * The SMMU's page tables are in the phone's low DRAM, outside the window the ADT
+ * declares as XNU's physical memory.  Neither phystokv() (illegal PA) nor
+ * ml_io_map()/ml_phys_read_double_64() (both validate against that window) can
+ * reach them, but the per-CPU copy window maps any page: that is the path
+ * bcopy_phys_internal() uses for exactly this reason.  Map, copy, unmap -- and
+ * map a whole page at a time, because a per-descriptor map/unmap made the first
+ * walk take seconds per table.
+ *
+ * `pa`, `bytes` and `buf` are 8-byte aligned by every caller (page-table
+ * entries), which is also what makes the volatile 64-bit accesses legal against
+ * the Device mapping.
+ */
+static void
+smmu_copy_phys(uint64_t pa, void *buf, uint64_t bytes, boolean_t to_phys)
+{
+	uint64_t done = 0;
+
+	mp_disable_preemption();
+	while (done < bytes) {
+		uint64_t cur = pa + done;
+		uint64_t off = cur & PAGE_MASK;
+		uint64_t chunk = PAGE_SIZE - off;
+		vm_offset_t addr;
+		unsigned int index;
+
+		if (chunk > bytes - done) {
+			chunk = bytes - done;
+		}
+		index = pmap_map_cpu_windows_copy(atop_kernel(cur),
+		    VM_PROT_READ | VM_PROT_WRITE, VM_WIMG_IO);
+		addr = pmap_cpu_windows_copy_addr(cpu_number(), index)
+		    | (vm_offset_t)off;
+
+		for (uint64_t i = 0; i + 8 <= chunk; i += 8) {
+			uint64_t *word = &((uint64_t *)buf)[(done + i) >> 3];
+			if (to_phys) {
+				*(volatile uint64_t *)(addr + i) = *word;
+			} else {
+				*word = *(volatile uint64_t *)(addr + i);
+			}
+		}
+		__asm__ volatile("dsb sy" ::: "memory");
+		pmap_unmap_cpu_windows_copy(index);
+		done += chunk;
+	}
+	mp_enable_preemption();
+}
+
+/*
+ * Per-level table scratch.  A descending walk needs its parent's entries to
+ * stay live while it reads the child, so each level gets its own buffer rather
+ * than one shared page-sized array.
+ */
+static uint64_t smmu_tbl[SMMU_LEVELS][SMMU_TABLE_MAX];
+
+/* ── contiguous-run accounting ─────────────────────────────────────────── */
+
+static void
+smmu_run_close(smmu_walk_t *w)
+{
+	unsigned int slot;
+
+	if (!w->cur_open) {
+		return;
+	}
+	w->cur_open = FALSE;
+
+	if (w->cur_bytes > w->largest_bytes) {
+		w->largest_bytes = w->cur_bytes;
+		w->largest_iova = w->cur_iova;
+		w->largest_pa = w->cur_pa;
+	}
+
+	/* Keep the biggest few completed runs, for the repoint phase to pick from. */
+	if (w->cur_bytes < SMMU_CAND_MIN) {
+		return;
+	}
+	if (w->ncand < SMMU_MAX_CANDIDATES) {
+		slot = w->ncand++;
+	} else {
+		unsigned int smallest = 0;
+		for (unsigned int i = 1; i < w->ncand; i++) {
+			if (w->cand[i].bytes < w->cand[smallest].bytes) {
+				smallest = i;
+			}
+		}
+		if (w->cand[smallest].bytes >= w->cur_bytes) {
+			return;
+		}
+		slot = smallest;
+	}
+	w->cand[slot].iova = w->cur_iova;
+	w->cand[slot].pa = w->cur_pa;
+	w->cand[slot].bytes = w->cur_bytes;
+	w->cand[slot].descs = w->cur_descs;
+}
+
+static void
+smmu_leaf(smmu_walk_t *w, uint64_t iova, uint64_t bytes, uint64_t pa)
+{
+	if (w->leaves == 0) {
+		w->first_iova = iova;
+	}
+	w->leaves++;
+	w->total_bytes += bytes;
+
+	/*
+	 * A run continues while the IOVA advances by exactly the descriptor's
+	 * size.  Continuity is *IOVA-only*: hw/m227 showed the display bank's
+	 * largest physically-contiguous run is a single 2 MB block while the bank
+	 * holds 156 MB in total, i.e. the scanout's blocks map scattered pages --
+	 * which is the whole reason a scanout goes through an SMMU.  Requiring
+	 * output-address continuity as well hid every framebuffer-sized run.
+	 */
+	if (w->cur_open && w->cur_iova + w->cur_bytes == iova) {
+		w->cur_bytes += bytes;
+		w->cur_descs++;
+		return;
+	}
+	smmu_run_close(w);
+	w->cur_open = TRUE;
+	w->cur_iova = iova;
+	w->cur_pa = pa;
+	w->cur_bytes = bytes;
+	w->cur_descs = 1;
+}
+
+/*
+ * Walk one stage-1 table tree and describe its mappings.
+ *
+ * Geometry, which the first version got wrong: a level covers
+ * (gshift - 3) bits of the IOVA, so
+ *
+ *   level 3 ->  4 K (4K granule) / 16 K (16K granule)
+ *   level 2 ->  2 MB            / 32 MB
+ *   level 1 ->  1 GB            / 64 GB
+ *
+ * `shift = gshift + (gshift - 3) * (3 - level)`.  The older `3 * (3 - level)`
+ * made a 2 MB block descriptor read as 32 KB, which is why hw/m226 reported
+ * "largest run 0x8000" for the display bank and could not name the
+ * framebuffer's ~18.4 MB run at all.
+ *
+ * The top level's entry count follows the VA size the context bank is
+ * configured for, not the table size: with T0SZ = 25 (39-bit VA, this device) a
+ * level-1 table has only 512 live entries.  Reading the full page yields garbage
+ * descriptors and the walk then recurses into whatever those words point at,
+ * which is what killed the boot at the first context bank.
+ */
+static void
+smmu_walk_table(uint64_t table_pa, int level, int gshift, int t0sz,
+    uint64_t base_iova, smmu_walk_t *w)
+{
+	int tbits = gshift - 3;
+	int tsize = 1 << tbits;
+	int shift = gshift + tbits * (3 - level);
+	int entries = tsize;
+	uint64_t *tbl = smmu_tbl[level];
+
+	if (level == 1) {
+		int va_bits = 64 - t0sz;
+		if (va_bits - shift > tbits) {
+			return;     /* a level-0 table would be needed: not walked */
+		}
+		entries = 1 << (va_bits - shift);
+	}
+	if (w->reads + (uint64_t)entries > SMMU_MAX_READS) {
+		return;             /* hard stop: never let a bad table drive the walk */
+	}
+	w->reads += (uint64_t)entries;
+	smmu_copy_phys(table_pa & SMMU_ADDR_MASK, tbl, (uint64_t)entries * 8, FALSE);
+
+	for (int i = 0; i < entries; i++) {
+		uint64_t desc = tbl[i];
+		uint64_t iova = base_iova + ((uint64_t)i << shift);
+
+		if ((desc & 0x1) == 0) {
+			smmu_run_close(w);      /* a hole ends the run */
+			continue;
+		}
+		if (w->descriptor_probe == 0) {
+			w->descriptor_probe = desc | 1;     /* never zero: see 0xb9 */
+		}
+
+		if ((desc & 0x3) == 0x1) {
+			/*
+			 * Block descriptor: a whole run at this level.  At level 3 the
+			 * same encoding is invalid, and treating it as a leaf (as the
+			 * first version did) invents mappings that do not exist.
+			 */
+			if (level < 3) {
+				smmu_leaf(w, iova, 1ULL << shift,
+				    (desc >> 12) & SMMU_PA_MASK);
+			} else {
+				smmu_run_close(w);
+			}
+			continue;
+		}
+
+		if (level < 3) {
+			smmu_walk_table(desc & SMMU_ADDR_MASK, level + 1, gshift,
+			    t0sz, iova, w);
+		} else {
+			smmu_leaf(w, iova, 1ULL << shift,
+			    (desc >> 12) & SMMU_PA_MASK);
+		}
+	}
+}
+
+/* ── repoint phase ─────────────────────────────────────────────────────── */
+
+/*
+ * Rewrite every leaf descriptor that covers [run_iova, run_iova + run_bytes) so
+ * the run maps new_pa instead of its original pages.
+ *
+ * Descriptor flags live in bits [11:0] and are preserved verbatim; only the
+ * output address moves, and it moves by the descriptor's offset inside the run,
+ * so the panel sees the same layout it did before -- our pixels instead of the
+ * composer's.  A block descriptor must stay naturally aligned (2 MB for a 4K
+ * granule), so a run whose base is not block-aligned leaves those blocks alone
+ * and counts them as skipped rather than corrupting the walk.
+ */
+static void
+smmu_rewrite_table(uint64_t table_pa, int level, int gshift, int t0sz,
+    uint64_t base_iova, smmu_rewrite_t *r)
+{
+	int tbits = gshift - 3;
+	int tsize = 1 << tbits;
+	int shift = gshift + tbits * (3 - level);
+	int entries = tsize;
+	uint64_t *tbl = smmu_tbl[level];
+	uint64_t run_end = r->run_iova + r->run_bytes;
+	boolean_t dirty = FALSE;
+
+	if (level == 1) {
+		int va_bits = 64 - t0sz;
+		if (va_bits - shift > tbits) {
+			return;
+		}
+		entries = 1 << (va_bits - shift);
+	}
+	if (r->reads + (uint64_t)entries > SMMU_MAX_READS) {
+		return;
+	}
+	r->reads += (uint64_t)entries;
+	smmu_copy_phys(table_pa & SMMU_ADDR_MASK, tbl, (uint64_t)entries * 8, FALSE);
+
+	for (int i = 0; i < entries; i++) {
+		uint64_t desc = tbl[i];
+		uint64_t iova = base_iova + ((uint64_t)i << shift);
+		uint64_t bytes = 1ULL << shift;
+		uint64_t target;
+		uint64_t newdesc;
+
+		if ((desc & 0x1) == 0) {
+			continue;
+		}
+
+		if (level < 3 && (desc & 0x3) == 0x3) {
+			smmu_rewrite_table(desc & SMMU_ADDR_MASK, level + 1, gshift,
+			    t0sz, iova, r);
+			continue;
+		}
+		/* leaf: a block at level 1/2, a page at level 3 */
+		if ((level < 3 && (desc & 0x3) != 0x1)
+		    || (level == 3 && (desc & 0x3) != 0x3)) {
+			continue;
+		}
+		if (iova < r->run_iova || iova + bytes > run_end) {
+			continue;
+		}
+
+		target = r->new_pa + (iova - r->run_iova);
+		if ((target & (bytes - 1)) != 0) {
+			r->skipped++;
+			continue;
+		}
+		newdesc = (target & SMMU_ADDR_MASK) | (desc & 0xFFF);
+		if (newdesc == desc) {
+			continue;
+		}
+
+		if (r->rewritten == 0) {
+			r->first_iova = iova;
+			r->first_before = desc;
+			r->first_after = newdesc;
+		}
+		tbl[i] = newdesc;
+		dirty = TRUE;
+		r->rewritten++;
+		r->rewritten_bytes += bytes;
+	}
+
+	if (dirty) {
+		smmu_copy_phys(table_pa & SMMU_ADDR_MASK, tbl,
+		    (uint64_t)entries * 8, TRUE);
+	}
+}
+
+/*
+ * Invalidate the stage-1 TLB for the rewritten run.
+ *
+ * TLBIASID covers the whole ASID, which is the operation with no operand
+ * encoding to get wrong: the ASID is the one in TTBR0's bits [55:48].  TLBIVA is
+ * also issued per page as a second, independent attempt -- this run's IOVAs are
+ * far below 4 GB, so the 32-bit operand is exact -- and TLBSYNC waits for both.
+ * Returns the last TLBSYNC read-back, which is 0 on a completed sync.
+ */
+static uint64_t
+smmu_tlb_flush(uint64_t cb_base, uint64_t ttbr0, uint64_t iova, uint64_t bytes)
+{
+	uint32_t asid = (uint32_t)((ttbr0 >> 48) & 0xFFFF);
+	uint32_t sync = 0xFFFFFFFFU;
+
+	(void)iova;
+	(void)bytes;
+	/* Match the installed arm_smmu driver: invalidate the whole stage-1 ASID. */
+	__asm__ volatile("dsb sy" ::: "memory");
+	smmu_write32(cb_base, SMMU_CB_TLBIASID, asid);
+	smmu_write32(cb_base, SMMU_CB_TLBSYNC, 0);
+	for (int i = 0; i < 1000000; i++) {
+		sync = smmu_read32(cb_base, SMMU_CB_TLBSTATUS);
+		if ((sync & 1) == 0) {
+			break;
+		}
+	}
+
+	return sync;
+}
+
+/*
+ * The display's own scanout buffer, published for the console.
+ *
+ * Repointing the SMMU at a buffer of ours works in principle, but every run
+ * since hw/m253 that did it ended with a black panel: the descriptors are
+ * rewritten in place, so the DPU fetches whatever the new PA holds, and a
+ * single malformed entry (wrong granule, wrong level, or a PA the bank cannot
+ * reach) turns the scanout into a translation fault and the pipe stops.
+ *
+ * The run's own physical address needs none of that.  It is the memory the
+ * panel was already scanning when Android's last frame was on screen, so a
+ * store there shows up on the next fetch with the SMMU left exactly as Linux
+ * configured it.  sweet_display_pa is that address (the first PA of the
+ * largest contiguous run in the display's context bank), and the console maps
+ * it instead of its own buffer.
+ */
+static uint64_t sweet_display_pa;
+static uint64_t sweet_display_bytes;
+
+/*
+ * The IOVA range the repoint actually rewrote.
+ *
+ * The console pipes fetch through the SMMU, so the address that matters to them
+ * is an IOVA, not a physical address: this is the run whose descriptors were
+ * pointed at our framebuffer, and therefore the address the pipes must name to
+ * read the console's pixels.  Published so pe_serial can program and then
+ * report it instead of assuming.
+ */
+extern void sweet_early_proof(uint64_t, uint64_t, uint64_t, uint64_t, uint64_t);
+
+static uint64_t sweet_repoint_iova;
+static uint64_t sweet_repoint_bytes;
+
+/*
+ * Returns 0 while the repoint is enabled: the console must then draw into its
+ * own buffer, because that is what the panel has been pointed at.
+ */
+uint64_t
+sweet_smmu_display_pa(void)
+{
+	return 0;
+}
+
+uint64_t
+sweet_smmu_display_bytes(void)
+{
+	return sweet_display_bytes;
+}
+
+uint64_t
+sweet_smmu_run_iova(void)
+{
+	return sweet_repoint_iova;
+}
+
+uint64_t
+sweet_smmu_run_bytes(void)
+{
+	return sweet_repoint_bytes;
+}
+
+/* The console's framebuffer, as the ADT describes it (mk_sm8850_adt.py). */
+static boolean_t
+smmu_fb_from_adt(uint64_t *pa, uint64_t *size)
+{
+	DTEntry entry;
+	uint64_t const *reg = NULL;
+	unsigned int len = 0;
+
+	if (SecureDTFindEntry("name", "sweet-fbcon", &entry) != kSuccess) {
+		return FALSE;
+	}
+	if (SecureDTGetProperty(entry, "reg", (void const **)&reg, &len) != kSuccess
+	    || len < 16) {
+		return FALSE;
+	}
+	*pa = reg[0];
+	*size = reg[1];
+	return TRUE;
+}
+
+/*
+ * Survey the SMMU, then repoint the display's scanout at our own buffer.
+ *
+ * hw/m227 showed eight context banks with translation on, and exactly one of
+ * them holding real memory: cb3 maps 156 MB, every other bank a couple of
+ * hundred kilobytes.  That is the display's bank, and it is the only one worth
+ * walking in detail -- so the survey walks them all, keeps the largest, and
+ * reports the run structure of that one.  Records (the ring only keeps ~16, so
+ * per-bank detail for every bank would evict everything else):
+ *
+ *   0xb6  a = ID0 | ID1 << 32          b = ID2 | ID7 << 32
+ *   0xba  a = banks with translation on   b = the chosen bank
+ *         c = its total mapped bytes       d = its valid leaf descriptors
+ *   0xb7  a = cb   b = SCTLR           c = TTBR0            d = TCR
+ *   0xb8  a = cb   b = total mapped bytes
+ *         c = largest IOVA-contiguous run bytes   d = that run's IOVA
+ *   0xb9  a = cb   b = first raw descriptor  c = leaves   d = run's first PA
+ *   0xbe  the chosen bank's four largest runs, one record each:
+ *         a = IOVA  b = bytes  c = first PA  d = descriptors in the run
+ *   0xbb  a = cb   b = runs repointed   c = first run IOVA   d = bytes total
+ *   0xbc  a = descriptors rewritten   b = bytes rewritten
+ *         c = descriptors skipped for alignment   d = our fb PA
+ *   0xbd  a = first descriptor before  b = first descriptor after
+ *         c = first rewritten IOVA     d = TLBSYNC read-back (0 = synced)
+ */
+void
+sweet_smmu_survey(void)
+{
+	uint64_t base;
+	uint32_t id0, id1, id2, id7, numcb, pgshift = 12, cb_page_base;
+	uint64_t cb_base[8];
+	uint64_t cb_ttbr0[8];
+	uint64_t cb_tcr[8];
+	uint32_t cb_num[8];
+	unsigned int found = 0;
+
+	uint64_t fb_pa = 0, fb_size = 0;
+	int best_cb = -1;
+	smmu_walk_t best = { 0 };
+
+	base = (uint64_t)(uintptr_t)ml_io_map(SMMU_APPS_BASE, SMMU_MAP_SIZE);
+	if (base == 0) {
+		sweet_early_evidence(0xb5, 0, 0, 0, 0);   /* no map */
+		return;
+	}
+
+	id0 = smmu_read32(base, SMMU_GR0_ID0);
+	id1 = smmu_read32(base, SMMU_GR0_ID1);
+	id2 = smmu_read32(base, SMMU_GR0_ID2);
+	id7 = smmu_read32(base, SMMU_GR0_ID7);
+
+	/*
+	 * ID1.PAGESIZE selects 4K vs 64K register pages; every CB page follows
+	 * the GR1 page, which itself follows the GR0 pages counted by
+	 * ID1.NUMPAGENDXB.
+	 */
+	if (id1 & (1U << 31)) {
+		pgshift = 16;
+	}
+
+	/*
+	 * The context-bank window starts one GR0 region after the base: arm-smmu.c
+	 * derives it as `numpage = 1 << (ID1.NUMPAGENDXB + 1)` pages, and every CB
+	 * page follows it.  With NUMPAGENDXB = 6 that is 128 pages, i.e. 0x80000 --
+	 * reading at 0x8000 only ever finds GR1's CBAR array.
+	 */
+	cb_page_base = 1U << (((id1 >> 28) & 0x7) + 1);
+
+	numcb = id1 & 0xFF;
+	if (numcb == 0 || numcb > SMMU_MAX_CB) {
+		numcb = SMMU_MAX_CB;
+	}
+
+	sweet_early_evidence(0xb6, ((uint64_t)id1 << 32) | id0,
+	    ((uint64_t)id7 << 32) | id2, numcb, pgshift);
+
+	for (uint32_t cb = 0; cb < numcb && found < 8; cb++) {
+		uint64_t this_cb = base + (cb_page_base << pgshift)
+		    + ((uint64_t)cb << pgshift);
+		uint64_t sctlr, ttbr0, tcr;
+
+		sctlr = smmu_read32(this_cb, SMMU_CB_SCTLR);
+		if ((sctlr & SCTLR_M) == 0) {
+			continue;
+		}
+		ttbr0 = smmu_read64(this_cb, SMMU_CB_TTBR0);
+		tcr = smmu_read32(this_cb, SMMU_CB_TCR);
+		cb_base[found] = this_cb;
+		cb_ttbr0[found] = ttbr0;
+		cb_tcr[found] = tcr;
+		cb_num[found] = cb;
+		found++;
+	}
+
+	if (!smmu_fb_from_adt(&fb_pa, &fb_size)) {
+		fb_pa = 0;
+		fb_size = 0;
+	}
+
+	for (unsigned int i = 0; i < found; i++) {
+		int t0sz = (int)(cb_tcr[i] & 0x3F);
+		int tg0 = (int)((cb_tcr[i] >> 14) & 0x3);
+		int granule_shift;
+		smmu_walk_t walk = { 0 };
+
+		if ((cb_tcr[i] & (1ULL << 31)) != 0) {
+			continue;       /* 64K granule tables: not walked here */
+		}
+		granule_shift = tg0 == 0 ? 12 : (tg0 == 1 ? 16 : 0);
+		if (granule_shift == 0) {
+			continue;       /* 64K granule */
+		}
+
+		smmu_walk_table(cb_ttbr0[i] & SMMU_ADDR_MASK, 1, granule_shift, t0sz,
+		    0, &walk);
+		smmu_run_close(&walk);
+
+		/*
+		 * The display is the bank with real memory behind it.  Keeping the
+		 * whole walk (not just its totals) keeps that bank's runs, which the
+		 * repoint phase needs, without a second traversal.
+		 */
+		if (best_cb < 0 || walk.total_bytes > best.total_bytes) {
+			best_cb = (int)i;
+			best = walk;
+		}
+	}
+
+	if (best_cb < 0) {
+		sweet_early_evidence(0xba, found, 0xFFFFFFFFU, 0, 0);
+		return;
+	}
+
+	sweet_early_evidence(0xba, found, cb_num[best_cb], best.total_bytes,
+	    best.leaves);
+	sweet_early_proof(0xb7, cb_num[best_cb],
+	    (uint64_t)smmu_read32(cb_base[best_cb], SMMU_CB_SCTLR),
+	    cb_ttbr0[best_cb], cb_tcr[best_cb]);
+	sweet_early_proof(0xb8, cb_num[best_cb], best.total_bytes,
+	    best.largest_bytes, best.largest_iova);
+	sweet_early_evidence(0xb9, cb_num[best_cb], best.descriptor_probe,
+	    best.leaves, best.largest_pa);
+
+	/*
+	 * Publish the scanout's own PA: the console draws there directly, which
+	 * needs no SMMU change at all.
+	 */
+	sweet_display_pa = best.largest_pa;
+	sweet_display_bytes = best.largest_bytes;
+
+	/* The run structure is what says whether the scanout is one run at all. */
+	for (unsigned int c = 0; c < best.ncand; c++) {
+		sweet_early_evidence(0xbe, best.cand[c].iova, best.cand[c].bytes,
+		    best.cand[c].pa, best.cand[c].descs);
+	}
+
+	/*
+	 * The repoint is off.
+	 *
+	 * It was the right idea and the wrong layer: it rewrites descriptors the
+	 * vendor driver owns, and hw/m253..m257 showed the panel going black every
+	 * time it ran.  The console now draws into the scanout's own memory
+	 * (sweet_display_pa), which leaves this SMMU untouched.  The loop is kept
+	 * because the records are still useful diagnostics on a bank whose walks
+	 * are being re-checked.
+	 */
+	if (1) {
+		int t0sz = (int)(cb_tcr[best_cb] & 0x3F);
+		int tg0 = (int)((cb_tcr[best_cb] >> 14) & 0x3);
+		int granule_shift = tg0 == 0 ? 12 : 16;
+		unsigned int hit = 0;
+		smmu_rewrite_t total = { 0 };
+		uint64_t first_iova = 0, first_bytes = 0, sync = 0;
+
+		for (unsigned int c = 0; c < best.ncand && fb_size != 0; c++) {
+			smmu_run_t *run = &best.cand[c];
+			smmu_rewrite_t rw = { 0 };
+
+			if (run->bytes < fb_size || run->bytes > fb_size + 0x600000) {
+				continue;
+			}
+			rw.run_iova = run->iova;
+			rw.run_bytes = run->bytes;
+			rw.new_pa = fb_pa;
+			smmu_rewrite_table(cb_ttbr0[best_cb] & SMMU_ADDR_MASK, 1,
+			    granule_shift, t0sz, 0, &rw);
+			sync = smmu_tlb_flush(cb_base[best_cb], cb_ttbr0[best_cb],
+			    run->iova, run->bytes);
+
+			if (hit == 0) {
+				first_iova = run->iova;
+				first_bytes = run->bytes;
+				total.first_before = rw.first_before;
+				total.first_after = rw.first_after;
+				total.first_iova = rw.first_iova;
+			}
+			total.rewritten += rw.rewritten;
+			total.rewritten_bytes += rw.rewritten_bytes;
+			total.skipped += rw.skipped;
+			hit++;
+		}
+
+		sweet_repoint_iova = first_iova;
+		sweet_repoint_bytes = first_bytes;
+		sweet_early_proof(0xbb, cb_num[best_cb], hit, first_iova, first_bytes);
+		/*
+		 * The console covers the whole run or the panel would scan text that
+		 * stops partway down the screen: fbcon uses the ADT geometry, and these
+		 * two records are what say whether that geometry and the run agree.
+		 */
+		sweet_early_proof(0xbc, total.rewritten, total.rewritten_bytes,
+		    total.skipped, fb_pa);
+		sweet_early_proof(0xbd, total.first_before, total.first_after,
+		    total.first_iova, sync);
+	}
+}
+
+#else /* !SWEET || SWEET_QEMU_LOG */
+
+void
+sweet_smmu_survey(void)
+{
+}
+
+#endif
