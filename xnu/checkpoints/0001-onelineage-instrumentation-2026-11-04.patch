diff -ruN a/osfmk/arm/sweet_crypto_stubs.c build/xnu-src/source/osfmk/arm/sweet_crypto_stubs.c
--- a/osfmk/arm/sweet_crypto_stubs.c	1969-12-31 16:00:00
+++ build/xnu-src/source/osfmk/arm/sweet_crypto_stubs.c	2026-10-31 01:01:52
@@ -0,0 +1,121 @@
+/*
+ * Minimal software corecrypto registration for SWEET (QEMU) builds.
+ *
+ * On real Apple platforms, a corecrypto kext calls register_crypto_functions()
+ * during early boot.  SWEET runs without kexts, so SHA256 and HMAC calls
+ * through g_crypto_funcs would fault on NULL+0x30.  Register the built-in
+ * LTC (LibTomCrypt) software implementations here so the rest of the kernel
+ * can use the normal g_crypto_funcs dispatch without crashing.
+ *
+ * AES, DES, RNG, RSA slots are left NULL.  Any caller that reaches them will
+ * panic — those will be guarded or stubbed as they are encountered.
+ */
+
+#if defined(SWEET) || defined(ARM64_BOARD_CONFIG_SWEET)
+
+#include <kern/debug.h>
+#include <libkern/crypto/register_crypto.h>
+#include <corecrypto/ccsha2.h>
+#include <corecrypto/ccdigest.h>
+#include <corecrypto/cchmac.h>
+#include <corecrypto/ccrng.h>
+#include <kern/startup.h>
+
+/* early_random() — XNU's builtin entropy source (no kext needed) */
+extern uint64_t early_random(void);
+
+/* Built-in software SHA256 — compiled from osfmk/corecrypto/ccsha256_ltc_di.c */
+extern const struct ccdigest_info ccsha256_ltc_di;
+
+/*
+ * ccdigest_final is inline in ccdigest.h (calls di->final()).  Provide a
+ * real function symbol so it can be stored in a function-pointer field.
+ */
+static void
+sweet_ccdigest_final(const struct ccdigest_info *di, ccdigest_ctx_t ctx, void *digest)
+{
+	di->final(di, ctx, digest);
+}
+
+/* ccdigest: init + update + final in one call */
+static void
+sweet_ccdigest(const struct ccdigest_info *di, unsigned long len,
+    const void *data, void *digest)
+{
+	ccdigest_di_decl(di, ctx);
+	ccdigest_init(di, ctx);
+	ccdigest_update(di, ctx, len, data);
+	di->final(di, ctx, digest);
+	ccdigest_di_clear(di, ctx);
+}
+
+/*
+ * Minimal CCRNG backed by early_random() (LFSR-seeded 64-bit PRNG).
+ * Cryptographically weak but sufficient for QEMU boot; no hardware RNG
+ * or corecrypto DRBG is needed to reach exec_init.
+ */
+static int
+sweet_ccrng_generate(struct ccrng_state *rng __unused, size_t outlen, void *out)
+{
+	uint8_t *p = (uint8_t *)out;
+	while (outlen >= 8) {
+		uint64_t r = early_random();
+		__builtin_memcpy(p, &r, 8);
+		p += 8; outlen -= 8;
+	}
+	if (outlen) {
+		uint64_t r = early_random();
+		__builtin_memcpy(p, &r, outlen);
+	}
+	return 0;
+}
+
+static struct ccrng_state sweet_ccrng_state = {
+	.generate = sweet_ccrng_generate,
+};
+
+static struct ccrng_state *
+sweet_ccrng_fn(int *error)
+{
+	if (error) {
+		*error = 0;
+	}
+	return &sweet_ccrng_state;
+}
+
+/* HMAC wrapper — cchmac_init/update/final/one-shot come from osfmk/corecrypto/ */
+static struct crypto_functions sweet_g_crypto_funcs = {
+	.ccdigest_init_fn    = ccdigest_init,
+	.ccdigest_update_fn  = ccdigest_update,
+	.ccdigest_final_fn   = sweet_ccdigest_final,
+	.ccdigest_fn         = sweet_ccdigest,
+
+	.ccmd5_di    = NULL,   /* no MD5 software impl in-kernel */
+	.ccsha1_di   = NULL,   /* no SHA1 software impl in-kernel */
+	.ccsha256_di = &ccsha256_ltc_di,
+	.ccsha384_di = NULL,
+	.ccsha512_di = NULL,
+
+	.cchmac_init_fn   = cchmac_init,
+	.cchmac_update_fn = cchmac_update,
+	.cchmac_final_fn  = cchmac_final,
+	.cchmac_fn        = cchmac,
+
+	/* RNG: minimal early_random()-backed CCRNG state */
+	.ccrng_fn         = sweet_ccrng_fn,
+
+	/* AES, DES, 3DES, RSA, chacha20, new digest/hmac APIs: NULL.
+	 * Accessing these fields will panic — guard call-sites as needed. */
+};
+
+static void
+sweet_crypto_init(void)
+{
+	if (register_crypto_functions(&sweet_g_crypto_funcs) != 0) {
+		panic("SWEET: register_crypto_functions failed (already registered?)");
+	}
+}
+
+STARTUP(CODESIGNING, STARTUP_RANK_FIRST, sweet_crypto_init);
+
+#endif /* SWEET */
