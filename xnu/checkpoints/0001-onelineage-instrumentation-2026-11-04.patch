+/*
+ * Stub for os/firehose_buffer_private.h — OneLineage QEMU build compat shim.
+ *
+ * The real header is part of libdispatch (closed for the XNU-8796 era).  For
+ * the QEMU early-console milestone we only need the build to succeed; actual
+ * firehose output is a later-milestone concern.  Returning NULL from
+ * __firehose_buffer_tracepoint_reserve causes _firehose_trace (log.c) to take
+ * the "drop the tracepoint" path, which is safe.
+ */
+#ifndef _OS_FIREHOSE_BUFFER_PRIVATE_H_
+#define _OS_FIREHOSE_BUFFER_PRIVATE_H_
+
+#include <firehose/tracepoint_private.h>
+#include <firehose/chunk_private.h>
+
+/* Number of firehose buffer chunks for the kernel log buffer. */
+#define FIREHOSE_BUFFER_KERNEL_CHUNK_COUNT           16
+#define FIREHOSE_BUFFER_KERNEL_DEFAULT_CHUNK_COUNT   8
+#define FIREHOSE_BUFFER_KERNEL_DEFAULT_IO_PAGES      0
+
+/* Create (or return a pre-allocated) kernel firehose buffer. */
+static inline firehose_buffer_t
+__firehose_buffer_create(size_t *size __unused)
+{
+	return NULL;
+}
+
+/* Process push replies from logd; returns true if more work remains. */
+static inline bool
+__firehose_merge_updates(firehose_push_reply_t reply __unused)
+{
+	return false;
+}
+
+/* Validate a proposed kernel firehose buffer configuration. */
+static inline bool
+__firehose_kernel_configuration_valid(uint8_t chunk_count,
+    uint8_t io_pages __unused)
+{
+	return chunk_count >= 2;
+}
+
+OS_ALWAYS_INLINE
+static inline firehose_tracepoint_t
+__firehose_buffer_tracepoint_reserve(uint64_t stamp __unused,
+    firehose_stream_t stream __unused,
+    uint16_t pubsize __unused,
+    uint16_t privsize __unused,
+    uint8_t **privptr __unused)
+{
+	return NULL;
+}
+
+OS_ALWAYS_INLINE
+static inline void
+__firehose_buffer_tracepoint_flush(firehose_tracepoint_t ft __unused,
+    firehose_tracepoint_id_u ftid __unused)
+{
+}
+
+#endif /* _OS_FIREHOSE_BUFFER_PRIVATE_H_ */
